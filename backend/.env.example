# Copie para backend/.env (NUNCA versione o .env).
ENV=development

# SQLite local por padrão. Produção: postgresql+psycopg://usuario:senha@host:5432/memecoinai
# DATABASE_URL=sqlite:///./data/memecoinai.db

# Usuários iniciais criados por `python -m app.cli seed-users`.
SEED_USERNAMES=natan,alisson
# Defina a senha inicial combinada com o proprietário. Troque antes de expor publicamente.
SEED_INITIAL_PASSWORD=change-me

# Sessão: em produção com HTTPS use true.
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=72

# Frontend em desenvolvimento (Vite).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Coleta
CHAINS=solana
MAX_TRACKED_TOKENS=10000
REFRESH_INTERVAL_SECONDS=30
DISCOVERY_INTERVAL_SECONDS=300
RISK_CHECK_INTERVAL_SECONDS=30
EVALUATION_INTERVAL_SECONDS=120
# RPC público tem limites rígidos (429 em getTokenLargestAccounts). Use um provedor próprio se possível.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Frescor (segundos)
FRESH_MAX_AGE_SECONDS=180
DELAYED_MAX_AGE_SECONDS=900

LOG_LEVEL=INFO
